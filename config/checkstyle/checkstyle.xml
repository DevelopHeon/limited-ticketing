<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="TreeWalker">
        <module name="IllegalType">
            <property name="illegalClassNames" value="var"/>
            <message key="illegal.type" value="Use an explicit type instead of var."/>
        </module>
        <module name="MethodName">
            <property name="format" value="^(?!set[A-Z])[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="Use a meaningful action name instead of a setXxx method: {0}."/>
        </module>
    </module>
</module>
